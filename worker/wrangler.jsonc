{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cfl-feedback-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true, "head_sampling_rate": 0.1 },

  // Decoding + hashing a large Facebook CSV export exceeds the 30s default.
  "limits": { "cpu_ms": 60000 },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfl-feedback",
      "database_id": "3ec76280-4616-4e4b-b343-d95d0ec432cc",
      "migrations_dir": "migrations"
    }
  ],

  "triggers": {
    "crons": ["45 6 * * *"]
  },

  // Which provider and model each slot uses lives in the provider catalog
  // (src/services/llmCatalog.ts) and llm_agent_configs, not here.
  "vars": {
    "CLASSIFY_BATCH_SIZE": "50",
    "ANALYSIS_BATCH_SIZE": "50",
    "TRANSLATION_BATCH_SIZE": "40",
    "LLM_BATCH_CONCURRENCY": "3",
    "PROCESSING_QUEUE_CONCURRENCY": "3",
    "LLM_VIAX_BASE_URL": "https://rpi7jss.abc-tunnel.us/v1"
  }
}
