{
  "name": "cfl-feedback-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to=./.wrangler/state",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply cfl-feedback --local",
    "db:migrate:remote": "wrangler d1 migrations apply cfl-feedback --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:node": "esbuild src/node/entry.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.js",
    "start:node": "node dist/server.js",
    "smoke:node": "node scripts/smoke-node.mjs",
    "build:import": "esbuild src/node/sqlDumpImport.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/sqlDumpImport.js",
    "smoke:import": "node scripts/smoke-import.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@libsql/client": "^0.18.0",
    "hono": "^4.6.14",
    "node-cron": "^4.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16",
    "wrangler": "^4.107.0"
  }
}
