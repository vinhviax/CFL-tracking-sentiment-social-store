# Copy to .env next to docker-compose.yml and fill in. .gitignore excludes *.env, so this
# example file is the only one that belongs in git — never put a real value here.
#
# Values are read by docker-compose.yml and passed into the api container. The same names
# are what Dokploy's environment-variable UI needs.

# --- Ports on the host ------------------------------------------------------------
API_PORT=8787
WEB_PORT=8080

# --- Frontend --------------------------------------------------------------------
# Baked into the bundle at build time (frontend/src/api/client.js), so changing it
# requires rebuilding the web image, not just restarting it.
VITE_API_BASE=http://localhost:8787

# --- Secrets (were `wrangler secret put` on Cloudflare) --------------------------
# Shared password gating every write on the Ingest & Cài đặt tab. LEAVING IT EMPTY
# LEAVES THE WORKSPACE OPEN: anyone with the link can pull, delete and re-run.
ADMIN_PASSWORD=

# VNG's internal LLM gateway — the only LLM a Dokploy container can reach.
LLM_VNG_LITE_API_KEY=

SENSORTOWER_API_KEY=
FB_PAGE_ID=
FB_ACCESS_TOKEN=

# --- Not usually needed ----------------------------------------------------------
# The Viax proxies are unreachable from the VNG network; set this only on a host that
# can actually reach them.
# LLM_VIAX_BASE_URL=
# LLM_VIAX_API_KEY=

# =================================================================================
# Below: the ORIGINAL contents of this file, kept as-is.
#
# They belong to `backend/` — the legacy FastAPI service, which is not the production
# backend and has been superseded by `worker/`. Several names are stale for the current
# stack (LLM_PROVIDER / LLM_*_MODEL moved into the provider catalog and the
# llm_agent_configs table; DATABASE_URL and SCHEDULE_DAILY_CRON have no reader in
# worker/). Left here so nothing is lost, not because Dokploy needs them.
# =================================================================================

# Sensor Tower (Store reviews)
SENSORTOWER_API_KEY=

# Facebook Graph API (Fanpage)
FB_PAGE_ID=
FB_ACCESS_TOKEN=

# LLM provider: anthropic | openai | openai_compatible
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_CLASSIFY_MODEL=claude-haiku-4-5-20251001
LLM_INSIGHT_MODEL=claude-sonnet-5

# Scheduler (cron, server local time)
SCHEDULE_DAILY_CRON=0 7 * * *

# Database
DATABASE_URL=sqlite:///data/cfl_feedback.db
