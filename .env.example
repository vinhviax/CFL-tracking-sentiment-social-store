# Copy this file to .env and fill in real values. NEVER commit .env

# Sensor Tower (Store reviews)
SENSORTOWER_API_KEY=

# Facebook Graph API (Fanpage)
FB_PAGE_ID=
FB_ACCESS_TOKEN=

# LLM provider: anthropic | openai | openai_compatible
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_CLASSIFY_MODEL=claude-haiku-4-5-20251001
LLM_INSIGHT_MODEL=claude-sonnet-5

# Scheduler (cron, server local time)
SCHEDULE_DAILY_CRON=0 7 * * *

# Database
DATABASE_URL=sqlite:///data/cfl_feedback.db
