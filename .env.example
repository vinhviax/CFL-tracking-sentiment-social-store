# Copy to .env next to docker-compose.yml and fill in. .gitignore excludes *.env, so this
# example file is the only one that belongs in git — never put a real value here.
#
# Values are read by docker-compose.yml and passed into the api container. The same names
# are what Dokploy's environment-variable UI needs.

# --- Ports on the host ------------------------------------------------------------
API_PORT=8787
WEB_PORT=8080

# --- Frontend --------------------------------------------------------------------
# Baked into the bundle at build time (frontend/src/api/client.js), so changing it
# requires rebuilding the web image, not just restarting it.
VITE_API_BASE=http://localhost:8787

# --- Secrets (were `wrangler secret put` on Cloudflare) --------------------------
# Shared password gating every write on the Ingest & Cài đặt tab. LEAVING IT EMPTY
# LEAVES THE WORKSPACE OPEN: anyone with the link can pull, delete and re-run.
ADMIN_PASSWORD=

# VNG's internal LLM gateway — the only LLM a Dokploy container can reach.
LLM_VNG_LITE_API_KEY=

SENSORTOWER_API_KEY=
FB_PAGE_ID=
FB_ACCESS_TOKEN=

# --- Not usually needed ----------------------------------------------------------
# The Viax proxies are unreachable from the VNG network; set this only on a host that
# can actually reach them.
# LLM_VIAX_BASE_URL=
# LLM_VIAX_API_KEY=
